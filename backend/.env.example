# ---------------------------------------------------------------------------
# Campus Connect backend – copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Django
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL – postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
# Set to True for managed databases that require SSL (Render external URL)
DB_SSL_REQUIRE=False

# Google Gemini – server side only, never in the React app
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_THINKING_BUDGET=0

# CORS – React dev server and your Vercel URL (comma separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional: allow Vercel preview deployments, e.g. ^https://campus-connect-.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=
CSRF_TRUSTED_ORIGINS=

# Frontend URL used in password-reset emails
FRONTEND_URL=http://localhost:5173

# College email verification
REQUIRE_COLLEGE_EMAIL=True
COLLEGE_EMAIL_SUFFIXES=.ac.in,.edu,.edu.in
# Optional exact allow-list, e.g. bmsce.ac.in,rvce.edu.in (overrides the suffixes)
ALLOWED_EMAIL_DOMAINS=

# JWT lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Rate limits
THROTTLE_AUTH=10/min
THROTTLE_AI=10/min
THROTTLE_AI_DAILY=100/day
THROTTLE_MESSAGES=30/min

# Media (uploaded images). On Render point MEDIA_ROOT at a persistent disk.
MEDIA_ROOT=
SERVE_MEDIA=True
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_PRODUCT=5

# Email (password reset). Console backend prints emails to the log by default.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Campus Connect <no-reply@example.com>
