# Base URL of the Django REST Framework backend (deployed on Render)
VITE_API_BASE_URL=http://localhost:8000/api

# Set to "true" once the Django backend is running to stop using sample data
VITE_USE_API=false

# NOTE: The Google Gemini API key must NEVER be placed here.
# It lives only in the Django backend environment (GEMINI_API_KEY).
