# Base URL of the Django REST Framework backend
#   local:  http://localhost:8000/api
#   Render: https://<your-service>.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# "true" = use the Django backend. "false" = run on built-in sample data (no backend needed).
VITE_USE_API=true

# NOTE: The Google Gemini API key must NEVER be placed here – VITE_* values are
# bundled into public JavaScript. It lives only in the backend (GEMINI_API_KEY).
